rules_version = '2';

/**
 * Firestore Security Rules — 2026 Camp Meeting T-Shirt App
 * CAC Good Works Assembly
 *
 * Paste this into Firebase Console → Firestore Database → Rules, or deploy
 * with the Firebase CLI (`firebase deploy --only firestore:rules`).
 *
 * Design:
 *  - products, settings: public read (the storefront needs them), admin-only write.
 *  - orders: anyone can CREATE an order (checkout must work with no login),
 *            but only a signed-in admin can READ the full order list or
 *            UPDATE/DELETE an order (status changes, soft delete).
 *  - counters: public get() only (needed by the checkout transaction that
 *              issues the next order number before the customer is signed
 *              in) — listing the collection stays admin-only, and the
 *              increment happens through a transaction that only ever
 *              increases the value by exactly 1, enforced below so order
 *              numbers can't be tampered with.
 *
 * NOTE on public order tracking: this app's "Check My Order" screen reads
 * a single order document directly by its order number. Because Firestore
 * rules cannot hide individual *fields* of a document from an unauthenticated
 * reader (only allow/deny the whole document), a determined visitor who
 * already knows a specific order number could technically also read that
 * order's phone/email fields directly from Firestore (not from this app's
 * UI, which never displays them). If that residual risk matters for your
 * event, move order tracking behind a Cloud Function that reads the order
 * with admin privileges server-side and returns only the safe fields
 * (items, totals, statuses) — see README.md for a starting point.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      // "create" (not update/delete) is left open so the app's one-time,
      // empty-collection seed (js/firebase-db.js -> seedIfEmpty) can run
      // the very first time anyone loads the app, before an admin has
      // signed in. Once a product document exists, only an admin can
      // change or remove it.
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      // Same reasoning as products: allow the initial seed write, then
      // lock changes to admin only.
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if true;              // needed for public order-number tracking
      allow list: if isAdmin();         // admin dashboard only — no browsing all orders
      allow create: if request.resource.data.orderNumber == orderId
                    && request.resource.data.paymentStatus == "Pending"
                    && request.resource.data.orderStatus == "Order Received"
                    && request.resource.data.deleted == false;
      allow update, delete: if isAdmin();
    }

    match /counters/{counterId} {
      // Every checkout reads this document inside a transaction
      // (js/firebase-db.js -> nextOrderNumber) before the customer is
      // authenticated, so "get" must be public. There is only ever one
      // fixed counter document, so this does not expose a listable
      // collection — "list" still requires admin.
      allow get: if true;
      allow list: if isAdmin();
      // The one-time seed creates this document at value 0.
      allow create: if isAdmin() || request.resource.data.value == 0;
      allow update: if isAdmin() ||
                    (request.resource.data.value == resource.data.value + 1);
      allow delete: if isAdmin();
    }
  }
}
